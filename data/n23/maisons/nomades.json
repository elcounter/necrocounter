  "regles": [
    {
      "nom": "Composition",
      "texte": "Mêmes restrictions de composition que les autres gangs. Aucune Alliance possible ; aucun Mercenaire sauf mention contraire. Parmi les Aventuriers, seuls ceux autorisés aux Nomades, plus leurs versions de Cartouchier, Toubib clandestin et Tambouilleur."
    },
    {
      "nom": "Chef de gang",
      "texte": "Un seul Sachem. Il ne prend jamais sa retraite en campagne ; s'il meurt ou quitte le gang, un autre combattant est promu."
    },
    {
      "nom": "Hiérarchie du gang",
      "texte": "Une fois le gang Dégonflé, si le Sachem réussit son test de Sang-froid en phase de Fin, les Nomades alliés à 12\" ou moins réussissent automatiquement le leur et ne fuient pas (6\" pour une Sentinelle ou un Hèle-tempête). Ces combattants font des actions d'après-bataille."
    },
    {
      "nom": "Les Ficelles du Métier",
      "texte": "Sachem, Sentinelles, Hèle-tempêtes, Chevaucheurs de Poussière et Spécialistes peuvent avoir plusieurs panoplies d'équipement."
    },
    {
      "nom": "Activation de groupe",
      "texte": "En s'activant, le Sachem peut activer à sa suite 2 Nomades Parés à 3\" ou moins, une Sentinelle 1, un par un. Ceux-ci ne relancent pas d'activation de groupe."
    },
    {
      "nom": "Combattants du gang",
      "texte": "Guerriers, Arpenteurs et Chevaucheurs de Poussière doivent être au moins aussi nombreux que les autres combattants (hors Aventuriers et Mercenaires)."
    },
    {
      "nom": "Né sur une selle",
      "texte": "Hèle-tempête et Chevaucheur de Poussière ne descendent jamais de leur Hélamite à Dos de Poussière, qui figure toujours sur leur carte."
    },
    {
      "nom": "Hélamite à Dos de Poussière",
      "texte": "Le combattant est Monté, son Mouvement passe à 8\" et il gagne la compétence Grand Bond."
    },
    {
      "nom": "Appel de la tempête",
      "texte": "Avec un bâton du hèle-tempête, le Hèle-tempête peut faire l'action Changer la Météo (Double) : active la règle de Visibilité (24\") si elle ne l'est pas, sinon augmente ou réduit sa valeur de 6\" (minimum 6\") jusqu'à la fin de la bataille."
    },
    {
      "nom": "Tête brûlée",
      "texte": "Si un Chevaucheur ou un Arpenteur de Poussière est Gravement Blessé ou mis Hors de Combat, ses alliés à 3\" ou moins ne font pas de test de Nervosité (sauf ceux qui ont aussi cette règle)."
    },
    {
      "nom": "Apprentissage rapide",
      "texte": "Chevaucheurs et Arpenteurs de Poussière ne paient pas le surcoût de 2 XP quand ils améliorent plusieurs fois la même caractéristique."
    },
    {
      "nom": "Promotion",
      "texte": "Au Temps Mort, un Chevaucheur de Poussière à 5 progressions ou plus peut devenir Sentinelle ou Hèle-tempête, un Arpenteur de Poussière Spécialiste. Des Guerriers peuvent aussi devenir Spécialistes en dépensant de l'XP."
    },
    {
      "nom": "Cape des cendres",
      "texte": "Compte comme un respirateur. Une perte de PV due aux conditions du champ de bataille est ignorée sur 5+."
    },
    {
      "nom": "Manteau céleste",
      "texte": "Action Se Cacher dans les Désolations (Double) : à 12\" ou plus de tout ennemi, le combattant devient Caché, même sans Noir Total. Bouger le rend Révélé."
    },
    {
      "nom": "En campagne Dominion",
      "texte": "Les Nomades ne tiennent pas de Territoires : ils démarrent avec un Avant-Poste des Nomades (revenu 2D6x10, impossible à perdre). Un Territoire qu'ils gagnent est pillé : il devient libre et remplacé par des Vieilles Ruines, et ils ajoutent 4D6x10 crédits au Magot. Un gang qui les défie en Prise de Contrôle attaque l'Avant-Poste (Zone Mortalis si possible, terrain posé par les Nomades, Avantage du Territoire Domiciliaire) ; s'il gagne, il prend +5 Réputation mais pas le Territoire."
    }
  ]
}

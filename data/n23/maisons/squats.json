  "regles": [
    {
      "nom": "Chef de gang",
      "texte": "Le gang a toujours un seul Maître Chartiste. Il ne prend jamais sa retraite en campagne ; s'il meurt ou quitte le gang, un autre combattant est promu à sa place."
    },
    {
      "nom": "Hiérarchie du gang",
      "texte": "Une fois le gang Dégonflé, si le Maître Chartiste réussit son test de Sang-froid en phase de Fin, les Squats alliés à 12\" ou moins réussissent automatiquement le leur et ne fuient pas (6\" pour un Maître Foreur). Ces deux rangs font des actions d'après-bataille."
    },
    {
      "nom": "Les Ficelles du Métier",
      "texte": "Maître Chartiste, Maîtres Foreurs et Spécialistes peuvent avoir plusieurs panoplies d'équipement."
    },
    {
      "nom": "Activation de groupe",
      "texte": "En s'activant, le Maître Chartiste peut activer à sa suite 2 Squats Parés à 3\" ou moins (1 pour un Maître Foreur), un par un. Ceux-ci ne relancent pas d'activation de groupe."
    },
    {
      "nom": "Combattants du gang",
      "texte": "Frères Foreurs et Creuseurs doivent être au moins aussi nombreux que les autres combattants (hors Aventuriers et Mercenaires)."
    },
    {
      "nom": "Promotion",
      "texte": "Un Creuseur qui a 5 progressions ou plus au Temps Mort peut devenir Spécialiste. Des Frères Foreurs peuvent aussi devenir Spécialistes en campagne en dépensant de l'XP."
    },
    {
      "nom": "Apprentissage rapide",
      "texte": "Le Creuseur ne paie pas le surcoût de 2 XP quand il améliore plusieurs fois la même caractéristique."
    },
    {
      "nom": "Module de puissance",
      "texte": "Les armes avec ce trait ne comptent pas dans la limite d'armes (deux au maximum par combattant). Une arme de Mêlée de ce type donne une attaque supplémentaire au corps à corps."
    },
    {
      "nom": "En campagne Dominion",
      "texte": "Le gang est traité comme les autres : il démarre avec une Colonie et prend des Territoires normalement."
    }
  ]
}

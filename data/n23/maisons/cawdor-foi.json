      "redemp"
    ]
  },
  "regles": [
    {
      "nom": "Liste Maison de la Foi",
      "texte": "Version de la liste Cawdor parue dans Maison de la Foi, avec ses deux lignées (Cawdor et Rédemptionniste). L'ancienne liste Cawdor reste disponible à côté."
    },
    {
      "nom": "Pieux ou Fanatique",
      "texte": "Gardien des Mots, Porte-flambeau, Fidèle Cawdor et Glaneur d'Os sont Pieux (relance d'un double 1 au Sang-froid en test de Ralliement). Prêtre Rédempteur, Diacre, Fidèle Rédemptionniste et Dévot sont Fanatiques (relance d'un double 1 au Sang-froid en test de Nervosité)."
    },
    {
      "nom": "Alignement",
      "texte": "À la fondation, majorité de Pieux : gang Intègre (Cawdor) ; majorité de Fanatiques : gang Hors-la-Loi (Rédemptionniste) ; égalité : selon le Chef. En campagne, si la composition change, test de Volonté du Chef à la fin de l'après-bataille (+3 facultatif s'il partage l'alignement du gang) ; en cas d'échec, l'alignement bascule."
    },
    {
      "nom": "Chef de gang",
      "texte": "Un seul Chef (Gardien des Mots ou Prêtre Rédempteur), qui ne prend jamais sa retraite en campagne ; s'il meurt ou quitte le gang, un autre combattant est promu."
    },
    {
      "nom": "Hiérarchie du gang",
      "texte": "Une fois le gang Dégonflé, si le Chef réussit son test de Sang-froid en phase de Fin, les Cawdor à 12\" ou moins réussissent automatiquement le leur (6\" pour un Champion). Chef et Champions font des actions d'après-bataille."
    },
    {
      "nom": "Activation de groupe",
      "texte": "Le Chef peut activer à sa suite 2 Cawdor Parés à 3\" ou moins, un Champion 1."
    },
    {
      "nom": "Les Ficelles du Métier",
      "texte": "Chefs, Champions et Spécialistes peuvent avoir plusieurs panoplies."
    },
    {
      "nom": "Voies de la Foi",
      "texte": "Le Chef choisit à la création une Voie (Fidèle, Fanatique, Damné ou Rédempteur) qui donne au gang des avantages et des Articles de Foi (dés de Foi, tests de Seuil) : voir le livre."
    },
    {
      "nom": "Guerrier Pur (Porte-flambeau)",
      "texte": "Une fois par bataille, il peut relancer ses dés de Foi lors d'un test de Seuil."
    },
    {
      "nom": "Ferveur Fanatique (Diacre)",
      "texte": "Une fois par bataille, en Charge, il peut doubler ses Attaques, mais avec -1 à chaque jet de touche."
    },
    {
      "nom": "Masses Dévotes",
      "texte": "En fin d'étape Choisir son Équipe, un Fidèle Cawdor supplémentaire et D3 Glaneurs d'Os supplémentaires peuvent rejoindre l'équipe, même au-delà de la taille imposée."
    },
    {
      "nom": "Combattants du gang",
      "texte": "Fidèles, Glaneurs d'Os et Dévots doivent être au moins aussi nombreux que les autres combattants (hors Aventuriers et Mercenaires)."
    },
    {
      "nom": "Glaneur d'Os",
      "texte": "Apprentissage rapide. Au Temps Mort, à 5 progressions ou plus, il peut devenir Spécialiste Cawdor ou Rédemptionniste."
    },
    {
      "nom": "Dévot",
      "texte": "Tête brûlée et Apprentissage rapide. Au Temps Mort, à 5 progressions ou plus, il peut devenir Spécialiste Rédemptionniste."
    },
    {
      "nom": "Exterminator",
      "texte": "Accessoire à usage unique monté sur une arme : un tir de lance-flammes (gabarit de Souffle)."
    }
  ]
}
